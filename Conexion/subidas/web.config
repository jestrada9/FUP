<?xml version="1.0" encoding="UTF-8"?>
<!-- Esta carpeta solo recibe archivos de carga temporales.
     accessPolicy="None" hace que IIS no ejecute ni sirva nada de aqui:
     cualquier peticion HTTP a esta ruta responde 403. -->
<configuration>
  <system.webServer>
    <handlers accessPolicy="None" />
  </system.webServer>
</configuration>
