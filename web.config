<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <system.webServer>
        <!-- Estaba en true: permitia a cualquiera listar el arbol completo del sitio. -->
        <directoryBrowse enabled="false" />
        <defaultDocument>
            <files>
                <add value="index.php" />
            </files>
        </defaultDocument>
        <security>
            <requestFiltering>
                <!-- Rutas que no deben responder por HTTP. No afecta los include()
                     de PHP, que trabajan sobre el sistema de archivos. -->
                <hiddenSegments>
                    <add segment=".git" />
                    <add segment="Errores" />
                    <add segment="_to_delete" />
                    <add segment="nbproject" />
                    <add segment="SQL" />
                </hiddenSegments>
                <!-- Extensiones que nunca deben descargarse: respaldos, volcados
                     de base y codigo que IIS serviria como texto plano. -->
                <fileExtensions allowUnlisted="true">
                    <add fileExtension=".rar" allowed="false" />
                    <add fileExtension=".bak" allowed="false" />
                    <add fileExtension=".sql" allowed="false" />
                    <add fileExtension=".phtml" allowed="false" />
                    <add fileExtension=".orig" allowed="false" />
                    <add fileExtension=".md" allowed="false" />
                </fileExtensions>
            </requestFiltering>
        </security>
    </system.webServer>
</configuration>
